# Variables de entorno para el backend

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=malafama
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Web Scraping
SCRAPING_TIMEOUT=30000
SCRAPING_HEADLESS=true

# Firebase sync (eventos_v3)
# Option A (recommended): paste minified service account JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: use a credentials file path (Windows example)
# GOOGLE_APPLICATION_CREDENTIALS=C:\\secrets\\firebase-service-account.json
FIRESTORE_COLLECTION=eventos_v3

# Platform Admin (SupernovaTel)
PLATFORM_ADMIN_EMAIL=admin@supernovatel.com
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_PASSWORD=supernova123

# Tenant referencia (defaults para nuevos tenants)
REFERENCIA_TENANT_NOMBRE=Tenant Admin (Referencia)
REFERENCIA_TENANT_PLAN_DEFAULT=gratuito
REFERENCIA_TENANT_MONEDA_DEFAULT=Bs
REFERENCIA_TENANT_MAX_LOCALES=999999
REFERENCIA_TENANT_SUSCRIPCION_DIAS=36500
