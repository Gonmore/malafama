CREATE TABLE public.usuarios (
    id uuid NOT NULL,
    nombre character varying(255) NOT NULL,
    email character varying(255) NOT NULL,
    password character varying(255) NOT NULL,
    tipo character varying(50) NOT NULL,
    activo boolean DEFAULT true,
    onboarding_completado boolean DEFAULT false,
    created_at timestamp with time zone NOT NULL,
    updated_at timestamp with time zone NOT NULL,
    local_id uuid,
    rol_cocina character varying(20),
    foto text,
    foto_url character varying(1000),
    CONSTRAINT usuarios_rol_cocina_check CHECK (((rol_cocina IS NULL) OR ((rol_cocina)::text = ANY (ARRAY[('cocina'::character varying)::text, ('bar'::character varying)::text])))),
    CONSTRAINT usuarios_tipo_check CHECK (((tipo)::text = ANY (ARRAY[('admin'::character varying)::text, ('atencion'::character varying)::text, ('cocina'::character varying)::text, ('bar'::character varying)::text, ('proveedor'::character varying)::text])))
);


