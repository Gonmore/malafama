# Copy this file to .env.prod on the server and fill the secrets.

# Docker networks (must exist on the server)
# Find them with: docker network ls
NPM_NETWORK=npm_default
POSTGRES_NETWORK=postgres_default

# Backend DB connection (existing container)
DB_HOST=postgres-principal
DB_PORT=5432
DB_NAME=malafama
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Backend auth
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE=7d

# CORS (your public domain)
CORS_ORIGIN=https://comandas.malafamacomedia.com
API_VERSION=v1

# Optional
LOG_SQL=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5000

# Startup
RUN_MIGRATIONS=true
DB_WAIT_RETRIES=60
DB_WAIT_SECONDS=2

# Frontend build-time API base (recommended: relative)
VITE_API_URL=/api/v1
