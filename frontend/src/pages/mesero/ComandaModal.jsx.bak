    async function enviarPedidos() { try { if (productosCarrito.length === 0) { toast.error('No hay productos seleccionados'); return; } setLoading(true); const pedidosData = productosCarrito.map(([productoId, cantidad]) => ({ productoId, cantidad: Number(cantidad), precioUnitario: parseFloat(productos.find(p => p.id === productoId)?.precio || 0) })); const pedidosConNotas = pedidosData.map(p => ({ ...p, notas: null })); if (usarComandaExistente && comanda?.id) { await comandaService.addPedidos(comanda.id, pedidosConNotas); } else { const resp = await comandaService.create({ mesaId: mesa.id, pedidos: pedidosConNotas }, { forzar: true }); if (resp?.data) setComanda(resp.data); } toast.success('Pedidos enviados a cocina/bar'); setCarrito({}); await cargarDatos(); setTimeout(() => onClose(), 700); } catch (err) { console.error('enviarPedidos', err); toast.error('Error al enviar pedidos'); } finally { setLoading(false); } }

    async function generarCuenta() { if (!comanda) return; if (Object.keys(carrito).length > 0) { toast.error('Debes enviar pedidos'); return; } try { setLoading(true); await api.put(`/comandas/${comanda.id}/cerrar`); toast.success('Cuenta generada y mesa cerrada'); onClose(); } catch (err) { console.error('generarCuenta', err); toast.error('Error al generar cuenta'); } finally { setLoading(false); } }

    if (mostrarResumen) { /* ... compact summary view ... */ }

    return (<div>/* simplified markup - preserved behavior */</div>);
  }
  const [productos, setProductos] = useState([]);
  const [comanda, setComanda] = useState(null);
  const [pedidos, setPedidos] = useState([]);
  const [carrito, setCarrito] = useState({});
  const [notasPorProducto, setNotasPorProducto] = useState({});
  const [categoriaFiltro, setCategoriaFiltro] = useState('');
  const [modoSeleccion, setModoSeleccion] = useState(''); // 'pick' | 'continue'
  const [selectedComandaId, setSelectedComandaId] = useState(null);
  const [usarComandaExistente, setUsarComandaExistente] = useState(true);
  const [mostrarResumen, setMostrarResumen] = useState(false);

  useEffect(() => { cargarDatos(); }, [mesa]);

  const cargarDatos = async () => {
    try {
      setLoading(true);
      const resp = await productoService.getAll({ activo: true });
      setProductos(resp.data || []);

      if (mesa?.comandas?.length > 0) {
        setSelectedComandaId(mesa.comandas[0].id);
        setModoSeleccion('pick');
        setComanda(null);
        setPedidos([]);
        setUsarComandaExistente(true);
      } else {
        setModoSeleccion('continue');
      }
    } catch (err) {
      console.error('cargarDatos', err);
      toast.error('Error cargando datos');
    } finally {
      setLoading(false);
    }
  };

  const entrarComandaExistente = async (id) => {
    try {
      setLoading(true);
      const resp = await comandaService.getById(id);
      if (resp?.data) {
        setComanda(resp.data);
        setPedidos(resp.data.pedidos || []);
        setModoSeleccion('continue');
        setUsarComandaExistente(true);
      }
    } catch (err) {
      console.error('entrarComandaExistente', err);
      toast.error('No se pudo abrir la comanda');
    } finally {
      setLoading(false);
    }
  };

  const crearComandaNueva = () => {
    setSelectedComandaId(null);
    setComanda(null);
    setPedidos([]);
    setModoSeleccion('continue');
    setUsarComandaExistente(false);
  };

  // Derived
  const categorias = Array.from(new Set(productos.map(p => p.categoria).filter(Boolean)));
  const productosFiltrados = productos.filter(p => !categoriaFiltro || p.categoria === categoriaFiltro);
  const productosCarrito = Object.entries(carrito);
  const cantidadProductosCarrito = productosCarrito.reduce((s, [, c]) => s + Number(c || 0), 0);
  const totalCarrito = productosCarrito.reduce((s, [id, c]) => {
    const prod = productos.find(p => p.id === id);
    return s + ((prod ? Number(prod.precio) : 0) * Number(c || 0));
  }, 0);
  const totalGeneral = totalCarrito + pedidos.reduce((s, p) => s + Number(p.subtotal || 0), 0);

  const handleProductoClick = (productoId) => setCarrito(prev => ({ ...prev, [productoId]: (prev[productoId] || 0) + 1 }));
  const modificarCantidad = (productoId, nuevaCantidad) => setCarrito(prev => {
    const copy = { ...prev };
    if (!nuevaCantidad || nuevaCantidad <= 0) delete copy[productoId]; else copy[productoId] = Number(nuevaCantidad);
    return copy;
  });

  const enviarPedidos = async () => {
    try {
      if (productosCarrito.length === 0) { toast.error('No hay productos seleccionados'); return; }
      setLoading(true);

      const pedidosData = productosCarrito.map(([productoId, cantidad]) => ({
        productoId,
        cantidad: Number(cantidad),
        precioUnitario: parseFloat(productos.find(p => p.id === productoId)?.precio || 0),
      }));

      const pedidosConNotas = pedidosData.map(p => ({ ...p, notas: notasPorProducto[p.productoId] || null }));

      if (usarComandaExistente && comanda?.id) {
        await comandaService.addPedidos(comanda.id, pedidosConNotas);
      } else {
        const resp = await comandaService.create({ mesaId: mesa.id, pedidos: pedidosConNotas }, { forzar: true });
        if (resp?.data) setComanda(resp.data);
      }

      toast.success('Pedidos enviados a cocina/bar');
      setCarrito({});
      setNotasPorProducto({});
      setMostrarResumen(false);
      await cargarDatos();
      setTimeout(() => onClose(), 700);
    } catch (err) {
      console.error('enviarPedidos', err);
      toast.error('Error al enviar pedidos');
    } finally { setLoading(false); }
  };

  const generarCuenta = async () => {
    if (!comanda) return; if (Object.keys(carrito).length > 0) { toast.error('Debes enviar pedidos pendientes'); return; }
    try { setLoading(true); await api.put(`/comandas/${comanda.id}/cerrar`); toast.success('Cuenta generada y mesa cerrada'); onClose(); } catch (err) { console.error('generarCuenta', err); toast.error('Error al generar cuenta'); } finally { setLoading(false); }
  };

  if (mostrarResumen) {
    return (
      <div className="fixed inset-0 bg-black bg-opacity-60 flex items-end sm:items-center justify-center z-50">
        <div className="bg-white rounded-t-3xl sm:rounded-3xl shadow-2xl w-full sm:max-w-2xl max-h-[90vh] overflow-hidden flex flex-col">
          <div className="p-4 border-b">
            <h3 className="text-lg font-bold">Resumen del pedido ({cantidadProductosCarrito})</h3>
          </div>
          <div className="p-4 overflow-y-auto flex-1">
            <div className="space-y-3">
              {productosCarrito.map(([productoId, cantidad]) => {
                const prod = productos.find(p => p.id === productoId);
                if (!prod) return null;
                return (
                  <div key={productoId} className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                    <div>
                      <div className="font-bold">{prod.nombre}</div>
                      <div className="text-sm text-gray-500">{cantidad} x {user?.local?.moneda || 'Bs'} {parseFloat(prod.precio).toFixed(2)}</div>
                    </div>
                    <div className="text-right font-bold">{user?.local?.moneda || 'Bs'} {(Number(prod.precio) * Number(cantidad)).toFixed(2)}</div>
                  </div>
                );
              })}
            </div>
          </div>
          <div className="p-4 border-t flex justify-between">
            <button onClick={() => setMostrarResumen(false)} className="px-4 py-2 border rounded-lg">Volver</button>
            <button onClick={enviarPedidos} className="px-4 py-2 bg-green-600 text-white rounded-lg">Enviar pedidos</button>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="fixed inset-0 bg-black bg-opacity-60 flex items-end sm:items-center justify-center z-50">
      <div className="bg-gradient-to-br from-blue-50 to-purple-50 rounded-t-3xl sm:rounded-3xl shadow-2xl w-full sm:max-w-2xl sm:max-h-[90vh] max-h-[95vh] overflow-hidden flex flex-col">
        <div className="bg-gradient-to-r from-blue-600 to-purple-600 text-white px-4 py-4 flex items-center justify-between shadow-lg">
          <div>
            <h2 className="text-xl sm:text-2xl font-bold flex items-center gap-2"><span>🪑</span> Mesa {mesa.numero}</h2>
            {comanda && (<p className="text-xs text-blue-100 mt-1">Comanda #{comanda.id?.slice?.(0,8)}</p>)}
          </div>
          <button onClick={onClose} className="text-white hover:bg-white/20 rounded-full w-10 h-10 flex items-center justify-center text-2xl font-bold transition-colors">×</button>
        </div>

        {loading && !comanda ? (
          <div className="p-8 text-center flex-1 flex items-center justify-center">
            <div>
              <div className="animate-spin rounded-full h-12 w-12 border-b-4 border-blue-600 mx-auto" />
              <p className="mt-4 text-gray-600 font-medium">Cargando...</p>
            </div>
          </div>
        ) : (
          <div className="overflow-y-auto flex-1 relative p-4">
            {modoSeleccion === 'pick' && (
              <div className="absolute inset-0 z-30 flex items-center justify-center">
                <div className="bg-white p-6 rounded-xl shadow w-full max-w-lg">
                  <h3 className="text-lg font-semibold mb-3">Esta mesa ya tiene una comanda abierta</h3>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <button className="px-4 py-3 border rounded" onClick={() => entrarComandaExistente(selectedComandaId)}>Continuar</button>
                    <button className="px-4 py-3 rounded bg-gradient-to-r from-blue-600 to-purple-600 text-white" onClick={crearComandaNueva}>Crear nueva</button>
                  </div>
                  {mesa?.comandas?.length > 1 && (
                    <div className="mt-4 grid grid-cols-2 gap-2">{mesa.comandas.map(c => (<button key={c.id} className={'p-2 border rounded ' + (selectedComandaId === c.id ? 'bg-blue-100' : 'bg-white')} onClick={() => setSelectedComandaId(c.id)}>#{c.id?.slice?.(0,6)} — {new Date(c.createdAt).toLocaleTimeString()}</button>))}</div>
                  )}
                </div>
              </div>
            )}

            <div className={'p-4 ' + (modoSeleccion === 'pick' ? 'hidden' : '')}>
              <div className="flex gap-2 overflow-x-auto pb-2">
                <button onClick={() => setCategoriaFiltro('')} className={categoriaFiltro === '' ? 'px-4 py-2 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 text-white' : 'px-4 py-2 rounded-full bg-white'}>🍽️ Todas</button>
                {categorias.map(cat => (<button key={cat} onClick={() => setCategoriaFiltro(cat)} className={categoriaFiltro === cat ? 'px-4 py-2 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 text-white' : 'px-4 py-2 rounded-full bg-white'}>{cat}</button>))}
              </div>

              <div className="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-3">
                {productosFiltrados.map(prod => (<button key={prod.id} onClick={() => handleProductoClick(prod.id)} className="p-4 bg-white rounded-xl border hover:shadow"><div className="text-3xl">{prod.tipo === 'bebida' ? '🥤' : '🍔'}</div><div className="mt-2 font-bold">{prod.nombre}</div><div className="text-sm text-gray-500">{user?.local?.moneda || 'Bs'} {parseFloat(prod.precio).toFixed(2)}</div></button>))}
              </div>
            </div>

            {pedidos.length > 0 && (
              <div className={(modoSeleccion === 'pick' ? 'hidden' : '') + ' px-4 pb-4'}>
                <h3 className="text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">📋 Pedidos Actuales</h3>
                <div className="space-y-2">{pedidos.map(p => (<div key={p.id} className="flex justify-between items-center bg-white p-3 rounded"><div><div className="font-bold">{p.producto?.nombre}</div><div className="text-xs text-gray-500">{p.cantidad} x {user?.local?.moneda || 'Bs'} {parseFloat(p.precioUnitario).toFixed(2)}</div></div><div className="text-right">{user?.local?.moneda || 'Bs'} {(p.subtotal || 0).toFixed(2)}</div></div>))}</div>
              </div>
            )}

            {(pedidos.length > 0 || cantidadProductosCarrito > 0) && (
              <div className="px-4 pb-4"><div className="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-4 rounded-xl shadow-lg"><div className="flex justify-between items-center"><span className="text-lg font-bold">💰 Total General:</span><span className="text-2xl font-bold">{user?.local?.moneda || 'Bs'} {totalGeneral.toFixed(2)}</span></div></div></div>
            )}

            {cantidadProductosCarrito > 0 && <div className="h-20" />}
          </div>
        )}

        {cantidadProductosCarrito > 0 && (
          <div className="absolute bottom-4 left-4 right-4"><button onClick={() => setMostrarResumen(true)} className="w-full bg-gradient-to-r from-green-500 to-emerald-600 text-white px-6 py-4 rounded-2xl font-bold text-lg shadow-2xl">👀 Ver Pedido ({cantidadProductosCarrito})</button></div>
        )}

        {cantidadProductosCarrito === 0 ? (
          <div className="bg-white/80 backdrop-blur-sm px-4 py-3 flex gap-2 border-t-2 border-gray-200 shadow-lg"><button onClick={onClose} className="flex-1 px-4 py-3 border-2 border-gray-300 rounded-xl text-gray-700 hover:bg-gray-100">← Volver</button>{comanda && pedidos.length > 0 && (<button onClick={generarCuenta} disabled={loading} className="flex-1 bg-gradient-to-r from-green-500 to-emerald-600 text-white px-6 py-3 rounded-xl font-bold">💰 Generar Cuenta</button>)}</div>
        ) : (
          <div className="bg-white/90 px-4 py-3 flex gap-2 border-t"><button onClick={onClose} className="flex-1 px-4 py-3 border rounded">Cerrar</button><div className="flex-1">{cantidadProductosCarrito > 0 && (<button onClick={() => setMostrarResumen(true)} className="w-full px-4 py-2 bg-green-500 text-white rounded">Ver Pedido ({cantidadProductosCarrito})</button>)}</div>{comanda && pedidos.length > 0 && (<button onClick={generarCuenta} disabled={loading} className="px-4 py-3 bg-emerald-600 text-white rounded">💰 Generar Cuenta</button>)}</div>
        )}
      </div>
    </div>
  );
}import { useEffect, useState } from 'react';
import { toast } from 'react-hot-toast';
import { useAuthStore } from '../../store/authStore';
import api from '../../services/api';
import { comandaService } from '../../services/comandaService';
import { productoService } from '../../services/productoService';

export default function ComandaModal({ mesa, onClose }) {
  const { user } = useAuthStore();

  const [comanda, setComanda] = useState(null);
  const [selectedComandaId, setSelectedComandaId] = useState(null);
  const [productos, setProductos] = useState([]);
  const [pedidos, setPedidos] = useState([]);
  const [loading, setLoading] = useState(true);
  const [categoriaFiltro, setCategoriaFiltro] = useState('');
  const [carrito, setCarrito] = useState({});
  const [mostrarResumen, setMostrarResumen] = useState(false);
  const [notasPorProducto, setNotasPorProducto] = useState({});
  const [usarComandaExistente, setUsarComandaExistente] = useState(true);
  const [modoSeleccion, setModoSeleccion] = useState(''); // 'pick' | 'continue'

  useEffect(() => { cargarDatos(); }, [mesa]);

  const cargarDatos = async () => {
    try {
      setLoading(true);
      const prodResp = await productoService.getAll({ activo: true });
      setProductos(prodResp.data || []);

      if (mesa?.comandas?.length > 0) {
        setSelectedComandaId(mesa.comandas[0].id);
        setModoSeleccion('pick');
        setComanda(null);
        setPedidos([]);
      } else {
        setModoSeleccion('continue');
      }
    } catch (err) {
      console.error('cargarDatos', err);
      toast.error('Error cargando datos');
    } finally { setLoading(false); }
  };

  const entrarComandaExistente = async (id) => {
    try {
      setLoading(true);
      const resp = await comandaService.getById(id);
      if (resp?.data) {
        setComanda(resp.data);
        setPedidos(resp.data.pedidos || []);
        setModoSeleccion('continue');
        setUsarComandaExistente(true);
      }
    } catch (err) {
      console.error('entrarComandaExistente', err);
      toast.error('No se pudo abrir la comanda');
    } finally { setLoading(false); }
  };

  const crearComandaNueva = () => {
    setSelectedComandaId(null);
    setComanda(null);
    setPedidos([]);
    setModoSeleccion('continue');
    setUsarComandaExistente(false);
  };

  const categorias = Array.from(new Set(productos.map(p => p.categoria).filter(Boolean)));
  const productosFiltrados = productos.filter(p => !categoriaFiltro || p.categoria === categoriaFiltro);
  const productosCarrito = Object.entries(carrito);
  const cantidadProductosCarrito = productosCarrito.reduce((s, [, c]) => s + Number(c || 0), 0);
  const totalCarrito = productosCarrito.reduce((s, [id, c]) => {
    const prod = productos.find(p => p.id === id);
    return s + ((prod ? Number(prod.precio) : 0) * Number(c || 0));
  }, 0);
  const totalGeneral = totalCarrito + pedidos.reduce((s, p) => s + (p.subtotal ? Number(p.subtotal) : 0), 0);

  const handleProductoClick = (productoId) => setCarrito(prev => ({ ...prev, [productoId]: (prev[productoId] || 0) + 1 }));
  const modificarCantidad = (productoId, nuevaCantidad) => setCarrito(prev => {
    const copy = { ...prev };
    if (!nuevaCantidad || nuevaCantidad <= 0) delete copy[productoId]; else copy[productoId] = Number(nuevaCantidad);
    return copy;
  });

  const enviarPedidos = async () => {
    try {
      if (productosCarrito.length === 0) { toast.error('No hay productos seleccionados'); return; }
      setLoading(true);

      const pedidosData = productosCarrito.map(([productoId, cantidad]) => ({
        productoId,
        cantidad: Number(cantidad),
        precioUnitario: parseFloat(productos.find(p => p.id === productoId)?.precio || 0),
      }));

      const pedidosConNotas = pedidosData.map(p => ({ ...p, notas: notasPorProducto[p.productoId] || null }));

      if (usarComandaExistente && comanda?.id) {
        await comandaService.addPedidos(comanda.id, pedidosConNotas);
      } else {
        const resp = await comandaService.create({ mesaId: mesa.id, pedidos: pedidosConNotas }, { forzar: true });
        if (resp?.data) setComanda(resp.data);
      }

      toast.success('Pedidos enviados a cocina/bar');
      setCarrito({});
      setNotasPorProducto({});
      setMostrarResumen(false);
      await cargarDatos();
      setTimeout(() => onClose(), 700);
    } catch (err) {
      console.error('enviarPedidos', err);
      toast.error('Error al enviar pedidos');
    } finally { setLoading(false); }
  };

  const generarCuenta = async () => {
    if (!comanda) return;
    if (Object.keys(carrito).length > 0) { toast.error('Debes enviar pedidos pendientes'); return; }
    try {
        setModoSeleccion('continue');
      }
    } catch (err) {
      console.error('cargarDatos', err);
      toast.error('Error cargando datos');
    } finally {
      setLoading(false);
    }
  }

  async function entrarComandaExistente(id) {
    try {
      setLoading(true);
      const resp = await comandaService.getById(id);
      if (resp?.data) {
        setComanda(resp.data);
        setPedidos(resp.data.pedidos || []);
        setModoSeleccion('continue');
        setUsarComandaExistente(true);
      }
    } catch (err) {
      console.error('entrarComandaExistente', err);
      toast.error('No se pudo abrir la comanda');
    } finally {
      setLoading(false);
    }
  }

  function crearComandaNueva() {
    setSelectedComandaId(null);
    setComanda(null);
    setPedidos([]);
    setModoSeleccion('continue');
    setUsarComandaExistente(false);
  }

  // derived
  const categorias = Array.from(new Set(productos.map(p => p.categoria).filter(Boolean)));
  const productosFiltrados = productos.filter(p => !categoriaFiltro || p.categoria === categoriaFiltro);
  const productosCarrito = Object.entries(carrito);
  const cantidadProductosCarrito = productosCarrito.reduce((s, [, c]) => s + Number(c || 0), 0);
  const totalCarrito = productosCarrito.reduce((s, [id, c]) => {
    const prod = productos.find(p => p.id === id);
    return s + ((prod ? Number(prod.precio) : 0) * Number(c || 0));
  }, 0);
  const totalGeneral = totalCarrito + pedidos.reduce((s, p) => s + Number(p.subtotal || 0), 0);

  const handleProductoClick = (productoId) => setCarrito(prev => ({ ...prev, [productoId]: (prev[productoId] || 0) + 1 }));
  const modificarCantidad = (productoId, nuevaCantidad) => setCarrito(prev => {
    const copy = { ...prev };
    if (!nuevaCantidad || nuevaCantidad <= 0) delete copy[productoId]; else copy[productoId] = Number(nuevaCantidad);
    return copy;
  });

  async function enviarPedidos() {
    try {
      if (productosCarrito.length === 0) {
        toast.error('No hay productos seleccionados');
        return;
      }

      setLoading(true);
      const pedidosData = productosCarrito.map(([productoId, cantidad]) => ({
        productoId,
        cantidad: Number(cantidad),
        precioUnitario: parseFloat(productos.find(p => p.id === productoId)?.precio || 0)
      }));

      const pedidosConNotas = pedidosData.map(p => ({ ...p, notas: notasPorProducto[p.productoId] || null }));

      if (usarComandaExistente && comanda?.id) {
        await comandaService.addPedidos(comanda.id, pedidosConNotas);
      } else {
        const resp = await comandaService.create({ mesaId: mesa.id, pedidos: pedidosConNotas }, { forzar: true });
        if (resp?.data) setComanda(resp.data);
      }

      toast.success('Pedidos enviados a cocina/bar');
      setCarrito({});
      setNotasPorProducto({});
      await cargarDatos();
      setTimeout(() => onClose(), 700);
    } catch (err) {
      console.error('enviarPedidos', err);
      toast.error('Error al enviar pedidos');
    } finally {
      setLoading(false);
    }
  }

  async function generarCuenta() {
    if (!comanda) return;
    if (Object.keys(carrito).length > 0) { toast.error('Debes enviar pedidos pendientes'); return; }
    try {
      setLoading(true);
      await api.put(`/comandas/${comanda.id}/cerrar`);
      toast.success('Cuenta generada y mesa cerrada');
      onClose();
    } catch (err) {
      console.error('generarCuenta', err);
      toast.error('Error al generar cuenta');
    } finally { setLoading(false); }
  }

  // Simple selection UI + main grid
  return (
    <div className="fixed inset-0 bg-black bg-opacity-60 flex items-end sm:items-center justify-center z-50">
      <div className="bg-gradient-to-br from-blue-50 to-purple-50 rounded-t-3xl sm:rounded-3xl shadow-2xl w-full sm:max-w-2xl max-h-[95vh] overflow-hidden flex flex-col">
        <div className="bg-gradient-to-r from-blue-600 to-purple-600 text-white px-4 py-4 flex items-center justify-between">
          <div>
            <h2 className="text-xl sm:text-2xl font-bold">🪑 Mesa {mesa?.numero}</h2>
            {comanda && <p className="text-xs text-blue-100 mt-1">Comanda #{comanda.id?.slice?.(0, 8)}</p>}
          </div>
          <button className="text-white text-2xl" onClick={onClose}>×</button>
        </div>

        <div className="overflow-y-auto flex-1 relative p-4">
          {loading && !comanda && <div className="text-center py-8">Cargando...</div>}

          {/* Selection overlay */}
          {modoSeleccion === 'pick' && (
            <div className="absolute inset-0 z-30 flex items-center justify-center">
              <div className="bg-white p-6 rounded-xl shadow w-full max-w-lg">
                <h3 className="text-lg font-semibold mb-3">Esta mesa ya tiene una comanda abierta</h3>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <button className="px-4 py-3 border rounded" onClick={() => entrarComandaExistente(selectedComandaId)}>Continuar</button>
                  <button className="px-4 py-3 rounded bg-gradient-to-r from-blue-600 to-purple-600 text-white" onClick={crearComandaNueva}>Crear nueva</button>
                </div>
                {mesa?.comandas?.length > 1 && (
                  <div className="mt-4 grid grid-cols-2 gap-2">
                    {mesa.comandas.map(c => (
                      <button key={c.id} className={'p-2 border rounded ' + (selectedComandaId === c.id ? 'bg-blue-100' : 'bg-white')} onClick={() => setSelectedComandaId(c.id)}>
                        #{c.id?.slice?.(0,6)} — {new Date(c.createdAt).toLocaleTimeString()}
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </div>
          )}

          {/* Categories */}
          <div className={'p-4 ' + (modoSeleccion === 'pick' ? 'opacity-30 pointer-events-none' : '')}>
            <div className="flex gap-2 overflow-x-auto pb-2">
              <button className={categoriaFiltro === '' ? 'px-3 py-2 rounded-full bg-blue-600 text-white' : 'px-3 py-2 rounded-full bg-white'} onClick={() => setCategoriaFiltro('')}>Todas</button>
              {categorias.map(cat => (
                <button key={cat} className={categoriaFiltro === cat ? 'px-3 py-2 rounded-full bg-blue-600 text-white' : 'px-3 py-2 rounded-full bg-white'} onClick={() => setCategoriaFiltro(cat)}>{cat}</button>
              ))}
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-3">
              {productosFiltrados.map(prod => (
                <button key={prod.id} onClick={() => handleProductoClick(prod.id)} className="p-4 bg-white rounded-xl border hover:shadow">
                  <div className="text-3xl">{prod.tipo === 'bebida' ? '🥤' : '🍔'}</div>
                  <div className="mt-2 font-bold">{prod.nombre}</div>
                  <div className="text-sm text-gray-500">{user?.local?.moneda || 'Bs'} {parseFloat(prod.precio).toFixed(2)}</div>
                </button>
              ))}
            </div>
          </div>

          {/* Pedidos actuales */}
          {pedidos.length > 0 && (
            <div className={(modoSeleccion === 'pick' ? 'opacity-50 pointer-events-none' : '') + ' px-4 pb-4 mt-4'}>
              <h3 className="text-sm font-bold">📋 Pedidos actuales</h3>
              <div className="space-y-2 mt-2">
                {pedidos.map(p => (
                  <div key={p.id} className="flex justify-between items-center bg-white p-3 rounded">
                    <div>
                      <div className="font-bold">{p.producto?.nombre}</div>
                      <div className="text-xs text-gray-500">{p.cantidad} x {user?.local?.moneda || 'Bs'} {p.precioUnitario?.toFixed?.(2)}</div>
                    </div>
                    <div className="text-right">{user?.local?.moneda || 'Bs'} {(p.subtotal || 0).toFixed(2)}</div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {(pedidos.length > 0 || cantidadProductosCarrito > 0) && (
            <div className="px-4 pb-4 mt-4">
              <div className="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-4 rounded-xl shadow-lg">
                <div className="flex justify-between items-center">
                  <span className="font-bold">💰 Total General:</span>
                  <span className="text-2xl font-bold">{user?.local?.moneda || 'Bs'} {totalGeneral.toFixed(2)}</span>
                </div>
              </div>
            </div>
          )}

        </div>

        {/* Footer */}
        <div className="bg-white/80 px-4 py-3 flex gap-2 border-t">
          <button onClick={onClose} className="flex-1 px-4 py-3 border rounded">Cerrar</button>
          <div className="flex-1">
            {cantidadProductosCarrito > 0 && (
              <button onClick={() => setMostrarResumen(true)} className="w-full px-4 py-2 bg-green-500 text-white rounded">Ver Pedido ({cantidadProductosCarrito})</button>
            )}
          </div>
          {comanda && pedidos.length > 0 && (
            <button onClick={generarCuenta} disabled={loading} className="px-4 py-3 bg-emerald-600 text-white rounded">💰 Generar Cuenta</button>
          )}
        </div>

        {/* Modal resumen */}
        {mostrarResumen && (
          <div className="fixed inset-0 z-40 flex items-center justify-center bg-black bg-opacity-60">
            <div className="bg-white rounded-lg p-4 w-full max-w-md">
              <h4 className="font-bold mb-2">Resumen del pedido</h4>
              <div className="space-y-2 max-h-56 overflow-y-auto">
                {productosCarrito.map(([id, c]) => {
                  const p = productos.find(x => x.id === id);
                  if (!p) return null;
                  return (
                    <div key={id} className="flex justify-between items-center bg-gray-50 p-2 rounded">
                      <div>
                        <div className="font-semibold">{p.nombre}</div>
                        <div className="text-xs text-gray-500">{c} x {user?.local?.moneda || 'Bs'} {parseFloat(p.precio).toFixed(2)}</div>
                      </div>
                      <div className="font-semibold">{user?.local?.moneda || 'Bs'} {(Number(p.precio) * Number(c)).toFixed(2)}</div>
                    </div>
                  );
                })}
              </div>
              <div className="mt-4 flex justify-between">
                <button onClick={() => setMostrarResumen(false)} className="px-3 py-2 border rounded">Volver</button>
                <button onClick={enviarPedidos} className="px-3 py-2 bg-green-600 text-white rounded">Enviar pedidos</button>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
      
      // Cargar productos
      const prodResponse = await productoService.getAll({ activo: true });
      setProductos(prodResponse.data || []);

      // Verificar si la mesa tiene comanda abierta
      if (mesa.comandas && mesa.comandas.length > 0) {
        // Mostrar modo de selección: elegir continuar con la comanda o crear nueva
        setSelectedComandaId(mesa.comandas[0].id);
        setModoSeleccion('pick');
        // No cargamos pedidos automaticamente - esperamos a que el mesero elija
        return;
      }
      setModoSeleccion('continue');
    } catch (error) {
      console.error('Error al cargar datos:', error);
      toast.error('Error al cargar información');
    } finally {
      setLoading(false);
    }
  };

  const generarCuenta = async () => {
    if (!comanda) return;

    if (Object.keys(carrito).length > 0) {
      toast.error('Debes enviar los pedidos pendientes antes de generar la cuenta');
      return;
    }

    try {
      setLoading(true);
      await api.put(`/comandas/${comanda.id}/cerrar`);
      toast.success('Cuenta generada. Mesa cerrada');
      onClose();
    } catch (error) {
      console.error('Error al cerrar comanda:', error);
      toast.error('Error al generar cuenta');
    } finally {
        setLoading(false);
      }
    };

    // --- Helpers & computed properties for cart & UI ---
    const categorias = Array.from(new Set(productos.map(p => p.categoria).filter(Boolean)));
    const productosFiltrados = productos.filter(p => !categoriaFiltro || p.categoria === categoriaFiltro);
    const productosCarrito = Object.entries(carrito); // [ [prodId, cantidad], ... ]
    const cantidadProductosCarrito = productosCarrito.reduce((s, [, c]) => s + Number(c || 0), 0);
    const totalCarrito = productosCarrito.reduce((s, [id, c]) => {
      const prod = productos.find(p => p.id === id);
      return s + ((prod ? Number(prod.precio) : 0) * Number(c || 0));
    }, 0);

    const totalGeneral = totalCarrito + pedidos.reduce((s, p) => s + (p.subtotal ? Number(p.subtotal) : 0), 0);

    const handleProductoClick = (productoId) => {
      setCarrito(prev => ({ ...prev, [productoId]: (prev[productoId] || 0) + 1 }));
    };

    const modificarCantidad = (productoId, nuevaCantidad) => {
      setCarrito(prev => {
        const copy = { ...prev };
        if (!nuevaCantidad || nuevaCantidad <= 0) {
          delete copy[productoId];
        } else {
          copy[productoId] = Number(nuevaCantidad);
        }
        return copy;
      });
    };

    const entrarComandaExistente = async (id) => {
      try {
        setLoading(true);
        const resp = await comandaService.getById(id);
        if (resp?.data) {
          setComanda(resp.data);
          setPedidos(resp.data.pedidos || []);
          setModoSeleccion('continue');
          setUsarComandaExistente(true);
        }
      } catch (err) {
        console.error('Error entrando a comanda existente:', err);
        toast.error('No se pudo cargar la comanda');
      } finally {
        setLoading(false);
      }
    };

    const crearComandaNueva = () => {
      setSelectedComandaId(null);
      setComanda(null);
      setPedidos([]);
      setModoSeleccion('continue');
      setUsarComandaExistente(false);
    };

    const enviarPedidos = async () => {
      try {
        if (productosCarrito.length === 0) {
          toast.error('No hay productos seleccionados');
          return;
        }
        setLoading(true);

        // Preparar pedidos
        const pedidosData = productosCarrito.map(([productoId, cantidad]) => {
          const producto = productos.find(p => p.id === productoId);
          return {
            productoId,
            cantidad: Number(cantidad),
            precioUnitario: parseFloat(producto?.precio || 0)
          };
        });

        // Incluir notas
        const pedidosConNotas = pedidosData.map(p => ({ ...p, notas: notasPorProducto[p.productoId] || null }));

        if (usarComandaExistente && comanda && comanda.id) {
          await comandaService.addPedidos(comanda.id, pedidosConNotas);
        } else {
          const resp = await comandaService.create({ mesaId: mesa.id, pedidos: pedidosConNotas }, { forzar: true });
          if (resp?.data) setComanda(resp.data);
        }

        toast.success('Pedidos enviados a cocina/bar');
        setCarrito({});
        setNotasPorProducto({});
        setMostrarResumen(false);
        await cargarDatos();
        setTimeout(() => onClose(), 1000);
      } catch (error) {
        console.error('Error al enviar pedidos:', error);
        toast.error('Error al enviar pedidos');
      } finally {
        setLoading(false);
      }
    };

  

          

  if (mostrarResumen) {
    return (
      <div className="fixed inset-0 bg-black bg-opacity-60 flex items-end sm:items-center justify-center z-50">
        <div className="bg-white rounded-t-3xl sm:rounded-3xl shadow-2xl w-full sm:max-w-2xl max-h-[90vh] overflow-hidden flex flex-col">
          {/* Header */}
          <div className="p-4 border-b">
            <h3 className="text-lg font-bold">Resumen del pedido ({cantidadProductosCarrito})</h3>
          </div>

          <div className="p-4 overflow-y-auto flex-1">
            {/* Listado de items */}
            <div className="space-y-3">
              {Object.entries(carrito).map(([productoId, cantidad]) => {
                const prod = productos.find(p => p.id === productoId);
                if (!prod) return null;
                return (
                  <div key={productoId} className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                    <div>
                      <div className="font-bold">{prod.nombre}</div>
                      <div className="text-sm text-gray-500">{cantidad} x {user?.local?.moneda || 'Bs'} {parseFloat(prod.precio).toFixed(2)}</div>
                    </div>
                    <div className="text-right font-bold">{user?.local?.moneda || 'Bs'} {(Number(prod.precio) * Number(cantidad)).toFixed(2)}</div>
                  </div>
                );
              })}
            </div>
          </div>

          <div className="p-4 border-t flex justify-between">
            <button onClick={() => setMostrarResumen(false)} className="px-4 py-2 border rounded-lg">Volver</button>
            <button onClick={enviarPedidos} className="px-4 py-2 bg-green-600 text-white rounded-lg">Enviar pedidos</button>
          </div>
        </div>
      </div>
    );
  }

  // Modal Principal
  return (
    <div className="fixed inset-0 bg-black bg-opacity-60 flex items-end sm:items-center justify-center z-50">
      <div className="bg-gradient-to-br from-blue-50 to-purple-50 rounded-t-3xl sm:rounded-3xl shadow-2xl w-full sm:max-w-2xl sm:max-h-[90vh] max-h-[95vh] overflow-hidden flex flex-col">
        {/* Header */}
        <div className="bg-gradient-to-r from-blue-600 to-purple-600 text-white px-4 py-4 flex items-center justify-between shadow-lg">
          <div>
            <h2 className="text-xl sm:text-2xl font-bold flex items-center gap-2">
              <span>🪑</span> Mesa {mesa.numero}
            </h2>
            {comanda && (
              <p className="text-xs text-blue-100 mt-1">
                Comanda #{comanda.id.slice(0, 8)}
              </p>
            )}
          </div>
          <button
            onClick={onClose}
            className="text-white hover:bg-white/20 rounded-full w-10 h-10 flex items-center justify-center text-2xl font-bold transition-colors"
          >
            ×
          </button>
        </div>

        {loading && !comanda ? (
          <div className="p-8 text-center flex-1 flex items-center justify-center">
            <div>
              <div className="animate-spin rounded-full h-12 w-12 border-b-4 border-blue-600 mx-auto"></div>
              <p className="mt-4 text-gray-600 font-medium">Cargando...</p>
            </div>
          </div>
        ) : (
          <div className="overflow-y-auto flex-1 relative">
            {/* Selection overlay removed - use inline selection block below with CSS hiding */}
            {/* If there is an open comanda for this mesa, display a selection step so mesero chooses to continue or create a new one */}
            
            
            {/* Selector de Categorías */}
            <div className={`p-4 bg-white/50 backdrop-blur-sm sticky top-0 z-10 ${modoSeleccion === 'pick' ? 'hidden' : ''}`}>
              <h3 className="text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">
                📂 Categorías
              </h3>
              <div className="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
                <button
                  onClick={() => setCategoriaFiltro('')}
                  className={categoriaFiltro === '' ? 'px-4 py-2 rounded-full font-semibold text-sm whitespace-nowrap transition-all bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-lg scale-105' : 'px-4 py-2 rounded-full font-semibold text-sm whitespace-nowrap transition-all bg-white text-gray-700 hover:bg-gray-100'}
                >
                  🍽️ Todas
                </button>
                {categorias.map(cat => {
                  const emoji = cat.toLowerCase().includes('bebida') ? '🥤' : 
                                cat.toLowerCase().includes('comida') ? '🍔' :
                                cat.toLowerCase().includes('postre') ? '🍰' : 
                                cat.toLowerCase().includes('entrada') ? '🥗' :
                                cat.toLowerCase().includes('principal') ? '🍛' : '🍴';
                  return (
                    <button
                      key={cat}
                      onClick={() => setCategoriaFiltro(cat)}
                      className={categoriaFiltro === cat ? 'px-4 py-2 rounded-full font-semibold text-sm whitespace-nowrap transition-all bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-lg scale-105' : 'px-4 py-2 rounded-full font-semibold text-sm whitespace-nowrap transition-all bg-white text-gray-700 hover:bg-gray-100'}
                    >
                      {/* No remove button here - it belonged to products, not categories */}
                      {emoji} {cat}
                    </button>
                  );
                })}
              </div>
            

            {/* Grid de Productos */}
            <div className={'p-4 ' + (modoSeleccion === 'pick' ? 'hidden' : '')}>
              <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {productosFiltrados.map(prod => {
                  const cantidadEnCarrito = carrito[prod.id] || 0;
                  return (
                    <button
                      key={prod.id}
                      onClick={() => handleProductoClick(prod.id)}
                      className="relative p-4 rounded-xl transition-all active:scale-95 bg-white hover:shadow-xl shadow-md border-2 border-gray-200 hover:border-blue-400"
                    >
                      {/* Badge de cantidad */}
                      {cantidadEnCarrito > 0 && (
                        <div className="absolute -top-2 -right-2">
                          <div className="relative">
                            <div className="bg-gradient-to-r from-red-500 to-pink-500 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-lg animate-pulse">
                              {cantidadEnCarrito}
                            </div>
                          </div>
                        </div>
                      )}
                        {/* Small remove button placed in bottom-right corner of the product card for mobile */}
                        {cantidadEnCarrito > 0 && (
                          <div
                            role="button"
                            tabIndex={0}
                            onKeyDown={(e) => {
                              if (e.key === 'Enter' || e.key === ' ') {
                                e.stopPropagation();
                                modificarCantidad(prod.id, 0);
                              }
                            }}
                            onClick={(e) => {
                              e.stopPropagation();
                              modificarCantidad(prod.id, 0);
                            }}
                            aria-label="Quitar selección"
                            title="Quitar selección"
                            className="absolute -bottom-3 -right-3 bg-white text-red-600 rounded-full w-10 h-10 flex items-center justify-center border border-gray-200 shadow-md z-10 cursor-pointer"
                          >
                            ✕
                          </div>
                        )}
                      
                      <div className="text-3xl mb-2">
                        {prod.tipo === 'bebida' ? '🥤' : '🍔'}
                      </div>
                      <p className="font-bold text-sm mb-1 line-clamp-2 text-gray-800">
                        {prod.nombre}
                      </p>
                      <p className="text-lg font-bold text-blue-600">
                        {user?.local?.moneda || 'Bs'} {parseFloat(prod.precio).toFixed(2)}
                      </p>
                      <p className="text-[10px] mt-1 text-gray-500 uppercase font-semibold">
                        {prod.tipo}
                      </p>
                    </button>
                  );
                })}
              </div>
            </div>
            

            {/* Pedidos Existentes */}
            {pedidos.length > 0 && (
              <div className={modoSeleccion === 'pick' ? 'hidden px-4 pb-4' : 'px-4 pb-4'}> 
                <h3 className="text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">
                  📋 Pedidos Actuales
                </h3>
                <div className="space-y-2">
                  {pedidos.map((pedido) => (
                    <div
                      key={pedido.id}
                      className="flex items-center justify-between p-3 bg-white rounded-xl shadow-md border border-gray-200"
                    >
                      <div className="flex-1">
                        <p className="font-bold text-gray-800 text-sm">
                          {pedido.producto?.nombre}
                        </p>
                        <p className="text-xs text-gray-600 mt-0.5">
                          {pedido.cantidad} x {user?.local?.moneda || 'Bs'} {parseFloat(pedido.precioUnitario).toFixed(2)}
                          {pedido.producto?.tipo && (
                            <span className="ml-2 px-2 py-0.5 text-[10px] bg-blue-100 text-blue-700 rounded-full font-semibold">
                              {pedido.producto.tipo}
                            </span>
                          )}
                        </p>
                      </div>
                      <div className="text-right ml-3">
                        <p className="font-bold text-blue-600 text-base">
                          {user?.local?.moneda || 'Bs'} {parseFloat(pedido.subtotal).toFixed(2)}
                        </p>
                        <span className={'text-[10px] px-2 py-0.5 rounded-full font-semibold ' + (pedido.estado === 'listo' ? 'bg-green-100 text-green-700' : pedido.estado === 'en_preparacion' ? 'bg-yellow-100 text-yellow-700' : 'bg-gray-100 text-gray-700') }>
                          {pedido.estado}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            

            {/* Total General */}
            {(pedidos.length > 0 || cantidadProductosCarrito > 0) && (
              <div className="px-4 pb-4">
                <div className="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-4 rounded-xl shadow-lg">
                  <div className="flex justify-between items-center">
                    <span className="text-lg font-bold">💰 Total General:</span>
                    <span className="text-2xl font-bold">{user?.local?.moneda || 'Bs'} {totalGeneral.toFixed(2)}</span>
                  </div>
                </div>
              </div>
            )}

            {/* Espaciado para el botón flotante */}
            {cantidadProductosCarrito > 0 && <div className="h-20"></div>}
          </div>
        )}

        {/* Botón "Ver Pedido" Flotante */}
              {cantidadProductosCarrito > 0 && (
          <div className="absolute bottom-4 left-4 right-4">
            <button
              onClick={() => setMostrarResumen(true)}
              className="w-full bg-gradient-to-r from-green-500 to-emerald-600 text-white px-6 py-4 rounded-2xl font-bold text-lg shadow-2xl active:scale-95 transition-all animate-bounce"
            >
              👀 Ver Pedido ({cantidadProductosCarrito} {cantidadProductosCarrito === 1 ? 'producto' : 'productos'})
                    </button>
          </div>
        )}

        {/* Footer - Solo cuando NO hay carrito */}
        {cantidadProductosCarrito === 0 && (
          <div className="bg-white/80 backdrop-blur-sm px-4 py-3 flex gap-2 border-t-2 border-gray-200 shadow-lg">
            <button
              onClick={onClose}
              className="flex-1 px-4 py-3 border-2 border-gray-300 rounded-xl text-gray-700 hover:bg-gray-100 transition-all font-semibold active:scale-95"
            >
              ← Volver
            </button>
            
            {comanda && pedidos.length > 0 && (
              <button
                onClick={generarCuenta}
                disabled={loading}
                className="flex-1 bg-gradient-to-r from-green-500 to-emerald-600 text-white px-6 py-3 rounded-xl hover:from-green-600 hover:to-emerald-700 disabled:from-gray-400 disabled:to-gray-500 transition-all font-bold shadow-lg active:scale-95"
              >
                💰 Generar Cuenta
              </button>
            )}
          </div>
        )}
      </div>
    </div>
  );
}
